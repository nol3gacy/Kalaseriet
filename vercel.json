{
  "git": { "deploymentEnabled": { "work/*": false } },
  "redirects": [
    { "source": "/product/:slug*", "destination": "/kalas/:slug*", "permanent": true },
    { "source": "/category/kalas-for-:age", "destination": "/kalas/:age", "permanent": true },
    { "source": "/kalasbloggen/diy-kalaspase-billiga-och-roliga-gavor-barnen-kommer-alska", "destination": "/kalasbloggen/diy-kalaspase", "permanent": true },
    { "source": "/kalasbloggen/diy-kalaspase-billiga-och-roliga-gavor-barnen-kommer-alska/", "destination": "/kalasbloggen/diy-kalaspase", "permanent": true }
  ],
  "headers": [
    { "source": "/wf/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] }
  ]
}
